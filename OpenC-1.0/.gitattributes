# Keep source-manifest hashes stable across platforms.
* text=auto eol=lf

*.dll binary
*.exe binary
*.lib binary
*.obj binary
*.pdb binary
*.zip binary

# Preserve the audited upstream distribution byte-for-byte.
third_party/tinycc-win64/** -text
third_party/tinycc-win64/** linguist-vendored

# OpenC .p files are not Gnuplot.
*.p linguist-language=Text

# Generated Windows bindings are retained source artifacts.
standard_library/windows.raw/generated/** linguist-generated
