{
  "schema": "openc.sh27.production_corpus.v1",
  "version": 1,
  "description": "Additional single-function scaling stress, not a replacement for production CORPUS.json or its 20 parity checks. Whole input remains smaller than the production large-functions case.",
  "workloads": [
    {"id": "function_64", "source_files": 1, "functions_per_file": 1, "operations_per_function": 64},
    {"id": "function_256", "source_files": 1, "functions_per_file": 1, "operations_per_function": 256},
    {"id": "function_1024", "source_files": 1, "functions_per_file": 1, "operations_per_function": 1024}
  ],
  "runtime_workload": {
    "id": "startup_file_allocation", "fixture": "runtime", "iterations": 64,
    "allocation_bytes": 4096, "output_file": "sh27-runtime-payload.bin",
    "expected_stdout_line": "SH27_RUNTIME_OK"
  },
  "measurement": {
    "minimum_runs": 3, "sample_interval_seconds": 0.01,
    "max_private_mib_per_compiler": 512, "max_working_set_mib_per_compiler": 512,
    "max_captured_output_mib": 2, "execution_timeout_seconds": 30
  },
  "parity": {"maximum_openc_to_comparator_median_ratio": 1.25},
  "limits": {
    "maximum_source_files_per_workload": 1, "maximum_total_functions_per_workload": 1,
    "maximum_operations_per_function": 1024
  }
}
