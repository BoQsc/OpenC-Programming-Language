{
  "capabilities": [
    {
      "description": "UTF-8 source, lexer, parser, AST, diagnostics",
      "groups": [
        "compiler_d",
        "compiler_python_bootstrap"
      ],
      "id": "compiler.frontend"
    },
    {
      "description": "modules, names, types, constants, overloads, flow, status/out",
      "groups": [
        "compiler_d",
        "compiler_python_bootstrap"
      ],
      "id": "compiler.semantic"
    },
    {
      "description": "resources, ownership, borrowing, cleanup, pointers, unsafe",
      "groups": [
        "compiler_d",
        "compiler_python_bootstrap"
      ],
      "id": "compiler.safety"
    },
    {
      "description": "Core IR, D bootstrap backend, JSON IR, C11 bootstrap backend",
      "groups": [
        "compiler_d",
        "compiler_python_bootstrap"
      ],
      "id": "compiler.backend"
    },
    {
      "description": "executable compiler-in-OpenC frontend, complete semantic acceptance, canonical IR, native public CLI and language service, exact parity harnesses, and bootstrap gates",
      "groups": [
        "compiler_selfhost"
      ],
      "id": "compiler.selfhost"
    },
    {
      "description": "checked failures, memory, console, files, process",
      "groups": [
        "runtime_d",
        "runtime_c"
      ],
      "id": "runtime.hosted"
    },
    {
      "description": "freestanding hooks and startup",
      "groups": [
        "runtime_d",
        "runtime_c"
      ],
      "id": "runtime.freestanding"
    },
    {
      "description": "system.io, memory, file, path, process, text",
      "groups": [
        "standard_library_d",
        "standard_library_openc"
      ],
      "id": "standard_library.minimum_hosted"
    },
    {
      "description": "driver, formatter, LSP, explain, info, validate, package tools",
      "groups": [
        "tools_d",
        "tools_python",
        "compiler_d"
      ],
      "id": "tools.core"
    },
    {
      "description": "unit/integration source and authored fixtures",
      "groups": [
        "tests_d",
        "tests_openc",
        "tests_python"
      ],
      "id": "tests.and.conformance"
    },
    {
      "description": "local build, test, manifest, archive, and verification source",
      "groups": [
        "build_release_source"
      ],
      "id": "build.and.release"
    },
    {
      "description": "Windows Hosted native-compiler demo projects and deterministic execution harness",
      "groups": [
        "demos"
      ],
      "id": "demos.windows_hosted"
    }
  ],
  "claim": "SOURCE_COMPLETE_BY_AUTHORED_INVENTORY",
  "claim_excludes": [
    "compilation",
    "linking",
    "execution",
    "test pass",
    "platform verification",
    "independent review",
    "release readiness"
  ],
