{
  "$id": "openc://schema/implementation-record/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "type": "string"
    },
    "commands": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "extensions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "implementation": {
      "type": "string"
    },
    "limits": {
      "type": "object"
    },
    "results": {
      "type": "object"
    },
    "schema": {
      "const": "openc.implementation_record.v1"
    },
    "source_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "stage": {
      "enum": [
        "I0",
        "I1",
        "I2",
        "I3",
        "I4",
        "I5"
      ]
    },
    "toolchain": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "implementation",
    "candidate",
    "stage",
    "toolchain",
    "source_hashes",
    "commands",
    "results"
  ],
  "title": "OpenC implementation evidence record",
  "type": "object"
}
