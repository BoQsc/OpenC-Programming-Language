{
  "$id": "openc://schema/tool-context/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "type": "string"
    },
    "build_context": {
      "type": "object"
    },
    "canonical_source_extension": {
      "const": ".p"
    },
    "command": {
      "type": "string"
    },
    "effective_options": {
      "type": "object"
    },
    "environment_inputs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "extensions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "implementation": {
      "type": "object"
    },
    "dependencies": {
      "type": "array"
    },
    "limits": {
      "type": "object"
    },
    "module_map": {
      "type": "object"
    },
    "modules": {
      "type": "array"
    },
    "overrides": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "profile": {
      "enum": [
        "standard",
        "strict",
        "critical"
      ]
    },
    "project": {
      "type": [
        "string",
        "null",
        "object"
      ]
    },
    "schema": {
      "const": "openc.tool_context.v1"
    },
    "source_units": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "module": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "module"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "sources": {
      "type": "array"
    },
    "target": {
      "type": "object"
    },
    "types": {
      "type": "array"
    },
    "view": {
      "enum": [
        "context",
        "sources",
        "modules",
        "limits",
        "dependencies",
        "target",
        "types"
      ]
    }
  },
  "required": [
    "schema",
    "canonical_source_extension",
    "implementation",
    "project"
  ],
  "anyOf": [
    {
      "required": [
        "candidate",
        "command",
        "target",
        "profile",
        "extensions",
        "source_units",
        "module_map",
        "effective_options"
      ]
    },
    {
      "required": [
        "view"
      ]
    }
  ],
  "title": "OpenC active tool context",
  "type": "object"
}
